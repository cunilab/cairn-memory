{
 "tools": [
  {
   "description": "Search Cairn memory for past decisions, rules, gotchas and procedures. Returns cards {id,kind,title,summary,score,why}.",
   "inputSchema": {
    "properties": {
     "kind": {
      "enum": [
       "decision",
       "rule",
       "gotcha",
       "procedure",
       "fact",
       "preference",
       "note",
       "handoff"
      ],
      "type": "string"
     },
     "limit": {
      "description": "default 5",
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "query": {
      "type": "string"
     },
     "recorded_from": {
      "type": "string"
     },
     "recorded_to": {
      "type": "string"
     },
     "branch": {
      "type": "string"
     },
     "version": {
      "type": "string"
     },
     "projects": {
      "items": {
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     }
    },
    "required": [
     "query"
    ],
    "type": "object"
   },
   "name": "memory_search"
  },
  {
   "description": "Fetch records by id. Detail is off by default.",
   "inputSchema": {
    "properties": {
     "detail": {
      "default": false,
      "type": "boolean"
     },
     "field": {
      "maxLength": 40,
      "type": "string"
     },
     "ids": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     },
     "timeline": {
      "default": false,
      "type": "boolean"
     }
    },
    "required": [
     "ids"
    ],
    "type": "object"
   },
   "name": "memory_get"
  },
  {
   "description": "Save verified, reusable knowledge. Per note: title <=10 words, about 80 chars (200 max); summary one sentence, <=30 words, about 240 chars (1000 max). Move extra context to reason or detail. reason: why true or chosen (required except note), <=1,000 chars. fields by kind: decision {context, alternatives[], consequences}; rule {exceptions}; gotcha {symptom, cause, fix}; procedure {steps[], when}; fact {source}; preference {example}. supersedes=<id> replaces your memory or a memory scoped to the same project. contradicts=<id> for a conflict you cannot replace. Default scope: project in initialized repos, personal otherwise or for preference/note. No secrets, logs or guesses. items: up to 3 notes in one call. aliases: up to 5 short questions this answers.",
   "inputSchema": {
    "properties": {
     "aliases": {
      "items": {
       "maxLength": 120,
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     "contradicts": {
      "type": "string"
     },
     "detail": {
      "maxLength": 8000,
      "type": "string"
     },
     "evidence": {
      "description": "paths, commands, commits",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "fields": {
      "type": "object"
     },
     "items": {
      "items": {
       "properties": {
        "aliases": {
         "items": {
          "maxLength": 120,
          "type": "string"
         },
         "maxItems": 5,
         "type": "array"
        },
        "contradicts": {
         "type": "string"
        },
        "detail": {
         "maxLength": 8000,
         "type": "string"
        },
        "evidence": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "fields": {
         "type": "object"
        },
        "kind": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        },
        "scope": {
         "type": "string"
        },
        "summary": {
         "maxLength": 1000,
         "type": "string"
        },
        "supersedes": {
         "type": "string"
        },
        "title": {
         "maxLength": 200,
         "type": "string"
        }
       },
       "required": [
        "kind",
        "title",
        "summary"
       ],
       "type": "object"
      },
      "maxItems": 3,
      "type": "array"
     },
     "kind": {
      "enum": [
       "decision",
       "rule",
       "gotcha",
       "procedure",
       "fact",
       "preference",
       "note"
      ],
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "scope": {
      "enum": [
       "project",
       "personal",
       "global"
      ],
      "type": "string"
     },
     "summary": {
      "maxLength": 1000,
      "type": "string"
     },
     "supersedes": {
      "type": "string"
     },
     "title": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "name": "memory_save"
  },
  {
   "description": "Mark a memory helpful or wrong. Wrong from two people, or from its owner, makes it stale.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     },
     "vote": {
      "enum": [
       "helpful",
       "wrong"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "vote"
    ],
    "type": "object"
   },
   "name": "memory_feedback"
  },
  {
   "description": "Erase a memory you own. To replace outdated knowledge, save with supersedes instead.",
   "inputSchema": {
    "properties": {
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "name": "memory_forget"
  },
  {
   "description": "Search the global skill library. Returns cards with name, title, description, relevance score and votes.",
   "inputSchema": {
    "properties": {
     "limit": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "offset": {
      "minimum": 0,
      "type": "integer"
     },
     "query": {
      "maxLength": 1024,
      "type": "string"
     }
    },
    "required": [
     "query"
    ],
    "type": "object"
   },
   "name": "skill_search"
  },
  {
   "description": "Read a skill's full text by name or ID. Omit version for the latest version.",
   "inputSchema": {
    "properties": {
     "name_or_id": {
      "type": "string"
     },
     "version": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "name_or_id"
    ],
    "type": "object"
   },
   "name": "skill_get"
  },
  {
   "description": "Create a global skill or publish a new version with a change note.",
   "inputSchema": {
    "properties": {
     "body": {
      "maxLength": 32000,
      "type": "string"
     },
     "change_note": {
      "maxLength": 240,
      "type": "string"
     },
     "description": {
      "maxLength": 240,
      "type": "string"
     },
     "name": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
     },
     "title": {
      "maxLength": 80,
      "type": "string"
     }
    },
    "required": [
     "name",
     "title",
     "description",
     "body",
     "change_note"
    ],
    "type": "object"
   },
   "name": "skill_save"
  },
  {
   "description": "Mark a skill version helpful or wrong, with an optional note. Your latest vote replaces your earlier vote on that version.",
   "inputSchema": {
    "properties": {
     "name_or_id": {
      "type": "string"
     },
     "note": {
      "maxLength": 240,
      "type": "string"
     },
     "version": {
      "minimum": 1,
      "type": "integer"
     },
     "vote": {
      "enum": [
       "helpful",
       "wrong"
      ],
      "type": "string"
     }
    },
    "required": [
     "name_or_id",
     "version",
     "vote"
    ],
    "type": "object"
   },
   "name": "skill_feedback"
  }
 ]
}
