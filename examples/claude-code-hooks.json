{
  "env": {
    "CAIRN_OUTBOX": "/absolute/path/to/cairn-outbox.json"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/cairn/hook/cairn_hook.py --agent claude",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/cairn/hook/cairn_hook.py --agent claude",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/cairn/hook/cairn_hook.py --agent claude",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/cairn/hook/cairn_hook.py --agent claude",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/cairn/hook/cairn_hook.py --agent claude",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
